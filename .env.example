# Copiez ce fichier en .env (ou définissez ces variables chez votre hébergeur)
PORT=3000
NODE_ENV=production
SITE_URL=https://votre-domaine.com
# Compte administrateur créé au PREMIER démarrage uniquement (10 caractères min.)
ADMIN_USER=marthial
ADMIN_PASSWORD=changez-moi-vite-123
# Mettre 1 derrière un proxy (Nginx, Render, Railway…) pour lire la vraie IP
TRUST_PROXY=1
# Dossier de la base de données et des images envoyées (à placer sur un disque persistant)
DATA_DIR=./data
# Secret partagé avec l'agrégateur de paiement pour le webhook (optionnel)
PAY_WEBHOOK_SECRET=
